<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="@color/disabled_bg"/><stroke android:width="1dp" android:color="@color/disabled_stroke"/><corners android:radius="13dp"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/blue_dark"/><corners android:radius="13dp"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/blue"/><corners android:radius="13dp"/></shape>
    </item>
</selector>
