<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adminDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnAdminDashboardBack"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:clickable="true"
            android:contentDescription="@string/back"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/white"
            android:textSize="40sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administración"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Todo el control en un solo lugar"
                android:textColor="#DDEAFF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ACCESOS RÁPIDOS"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDashboardPeople"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/button_entry"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:text="Personal · corregir movimientos"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDashboardKeys"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_keys"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:text="Llaves · corregir movimientos"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDashboardDevices"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="10dp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:text="Dispositivos · asignar permisos"
                android:textAllCaps="false"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                android:text="FIREBASE → SHEETS"
                android:textColor="@color/muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDashboardSyncStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consultando sincronización…"
                    android:textColor="@color/text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDashboardSyncErrors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Consultando errores…"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnDashboardResolveErrors"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:enabled="false"
                    android:text="Marcar errores como resueltos"
                    android:textAllCaps="false"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnDashboardMonth"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/input"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:text="Seleccionar mes"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDashboardRebuildSheets"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/button_exit"
                android:text="Rehacer planillas"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
