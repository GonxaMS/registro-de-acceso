<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keysRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/back"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/back_symbol"
                android:textColor="@color/white"
                android:textSize="36sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/keys_title"
                    android:textColor="@color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtKeysToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#DDEAFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnKeySheets"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_exit"
                android:clickable="true"
                android:contentDescription="@string/open_sheets"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/sheet_icon"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/btnKeyMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:clickable="true"
                android:contentDescription="@string/more_options"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/more_options_symbol"
                android:textColor="@color/white"
                android:textSize="30sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/offlineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/offline_banner"
            android:gravity="center"
            android:padding="9dp"
            android:text="@string/offline_banner"
            android:textColor="@color/offline_banner_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputKeySearch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="9dp"
            android:hint="@string/search_keys_hint"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterKeysAll"
                style="@style/FilterChip"
                android:text="@string/filter_all" />

            <TextView
                android:id="@+id/filterKeysAvailable"
                style="@style/FilterChip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_available" />

            <TextView
                android:id="@+id/filterKeysBorrowed"
                style="@style/FilterChip"
                android:layout_marginStart="8dp"
                android:text="@string/filter_borrowed" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtKeyCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/listKeys"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="7dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="4dp"
            android:scrollbars="none" />
    </LinearLayout>
</LinearLayout>
